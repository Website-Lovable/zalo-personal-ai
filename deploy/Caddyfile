# Reverse proxy + automatic HTTPS (Let's Encrypt) for the production stack.
# DOMAIN and ACME_EMAIL come from the environment (docker-compose.prod.yml).
{
	email {$ACME_EMAIL}
	# Collect HTTP request metrics (rate, status, latency). The admin API stays on localhost.
	metrics
}

# Prometheus scrapes Caddy's metrics here; port 9180 is never published to the host.
:9180 {
	metrics /metrics
}

{$DOMAIN} {
	encode zstd gzip

	# Internal endpoints are never reachable from the Internet.
	@internal path /metrics /metrics/* /readyz /readyz/*
	respond @internal 404

	# The app sets CSP/X-Frame-Options itself; HSTS comes from Django (SECURE_HSTS_*).
	header {
		-Server
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	request_body {
		max_size 5MB
	}

	reverse_proxy web:8000 {
		# WebSocket upgrades (/ws/notifications/) pass through as-is.
		health_uri /healthz/
		health_interval 15s
		transport http {
			keepalive 60s
		}
	}

	log {
		output stdout
		format json
	}
}
