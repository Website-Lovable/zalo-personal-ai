# Production environment for docker-compose.prod.yml. Copy to .env.production ON THE SERVER,
# fill in, `chmod 600 .env.production`. NEVER commit the filled file.
# Generate random values with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Fernet key:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Server / domain (needed from the owner) ---
DOMAIN=zalo-ai.example.com
ACME_EMAIL=ops@example.com
ALLOWED_HOSTS=zalo-ai.example.com
PUBLIC_BASE_URL=https://zalo-ai.example.com
# Caddy is the only proxy in front of the app
TRUSTED_PROXY_COUNT=1

# --- Images (set by deploy.sh; override only to test another registry) ---
# APP_IMAGE=ghcr.io/website-lovable/zalo-personal-ai
# SIDECAR_IMAGE=ghcr.io/website-lovable/zalo-personal-sidecar

# --- Secrets (all different, all random) ---
SECRET_KEY=
JWT_SECRET_KEY=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
# Same value goes into deploy/monitoring/secrets/metrics_token for Prometheus
METRICS_TOKEN=
# Measured daily figures: pushed hourly (HMAC-signed) when OPS_PUSH_URL is set (https)
OPS_PUSH_URL=
OPS_PUSH_SECRET=
# Non-obvious path for the Django admin, e.g. quan-tri-<random>/
ADMIN_URL=quan-tri-change-me/

# --- Database / processes ---
POSTGRES_DB=zalo_ai
POSTGRES_USER=zalo
# Pool per process: (WEB_CONCURRENCY + CELERY_CONCURRENCY + 1) * DB_POOL_MAX_SIZE < 200
DB_POOL_MAX_SIZE=10
WEB_CONCURRENCY=3
CELERY_CONCURRENCY=4

# --- Error e-mails (optional but recommended) ---
ERROR_EMAIL_TO=
SERVER_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# --- Safety switches: keep these values until each go-live step is approved ---
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ZALO_CHANNEL_BACKEND=mock
ZALO_PERSONAL_UNOFFICIAL_ENABLED=false
ZALO_PERSONAL_EMERGENCY_STOP=false
AIVA_INTEGRATION_MODE=off
AIVA_LIVE_APPROVED=false
# Phase 6: number/date of the director's written approval of live (preflight fails without it)
AIVA_LIVE_APPROVAL_REF=
AI_ENGINE_ENABLED=true

# --- Zalo OA / Bot (fill in when the OA is approved; see docs/PHASE2_ZALO_SETUP.md) ---
ZALO_OA_APP_ID=
ZALO_OA_APP_SECRET=
ZALO_OA_WEBHOOK_SECRET=
ZALO_OA_OAUTH_REDIRECT_URI=https://zalo-ai.example.com/oauth/zalo-oa/callback/
ZALO_SITE_VERIFICATION_CODE=

# --- Personal Zalo sidecar (only with COMPOSE_PROFILES=personal) ---
ZALO_PERSONAL_SIDECAR_URL=http://zalo-personal:3100
ZALO_PERSONAL_SIDECAR_SECRET=

# --- AIVA (Phase 6, needs GĐ approval) ---
AIVA_BASE_URL=
AIVA_WEBHOOK_SECRET=
AIVA_SERVICE_TOKEN=
AIVA_INBOUND_SECRET=

# Every other setting has a safe default; see .env.example for the full list.
