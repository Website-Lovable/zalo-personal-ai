# Copy to .env and fill in. NEVER commit .env. Values below are placeholders, not secrets.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Database / Redis ---
DATABASE_URL=postgres://zalo:zalo@localhost:5432/zalo_ai
REDIS_URL=redis://localhost:6379/0

# --- Security ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
JWT_SECRET_KEY=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- LLM (Anthropic Claude via LLMProvider). Keep mock until Phase 3. ---
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL_MAIN=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5

# --- Zalo channels (Phase 2) ---
# mock = outbound messages stay in memory (no Zalo calls). real = official Zalo OA / Bot APIs.
ZALO_CHANNEL_BACKEND=mock
# Public HTTPS URL of this app; webhook and OAuth callback URLs are built from it.
PUBLIC_BASE_URL=
ZALO_HTTP_TIMEOUT_SECONDS=10
# Zalo OA app from developers.zalo.me (one app serves every tenant's OA)
ZALO_OA_APP_ID=
ZALO_OA_APP_SECRET=
# "OA Secret Key" on the app's Webhook page (used to check X-ZEvent-Signature)
ZALO_OA_WEBHOOK_SECRET=
# Must match the callback URL registered in the Zalo app: <PUBLIC_BASE_URL>/oauth/zalo-oa/callback/
ZALO_OA_OAUTH_REDIRECT_URI=
# Optional frontend page to land on after OAuth (?status=success|error&message=&channel_id=)
ZALO_OA_OAUTH_RESULT_URL=
ZALO_OA_OAUTH_URL=https://oauth.zaloapp.com/v4/oa
ZALO_OA_API_URL=https://openapi.zalo.me
ZALO_OA_TOKEN_REFRESH_MARGIN_SECONDS=3600
ZALO_OA_SYNC_PAGE_SIZE=50
ZALO_OA_SYNC_MAX_CONTACTS=5000
# Domain verification code from the Zalo developer console (served at /zalo_verifier<code>.html)
ZALO_SITE_VERIFICATION_CODE=
# Zalo Bot Platform (bot tokens are entered per channel in the app, stored encrypted)
ZALO_BOT_API_URL=https://bot-api.zaloplatforms.com
ZALO_BOT_POLL_TIMEOUT_SECONDS=10
ZALO_BOT_POLL_INTERVAL_SECONDS=15
# Personal Zalo (unofficial login). Keep false. See Kickoff section 3.
ZALO_PERSONAL_UNOFFICIAL_ENABLED=false

# --- AIVA integration: off | sandbox | live (live needs owner approval) ---
AIVA_INTEGRATION_MODE=off
AIVA_BASE_URL=
AIVA_SERVICE_TOKEN=
AIVA_WEBHOOK_SECRET=
AIVA_SIGNATURE_TOLERANCE_SECONDS=300

# --- App behaviour ---
DEFAULT_AI_RESPONSE_DELAY_SECONDS=3
APPROVAL_EXPIRY_HOURS=24
MAX_MEMORY_PER_CONTACT=100
CELERY_TASK_ALWAYS_EAGER=false
