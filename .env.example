# Copy to .env and fill in. NEVER commit .env. Values below are placeholders, not secrets.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Database / Redis ---
DATABASE_URL=postgres://zalo:zalo@localhost:5432/zalo_ai
REDIS_URL=redis://localhost:6379/0

# --- Security ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
JWT_SECRET_KEY=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- LLM (Anthropic Claude via LLMProvider) ---
# mock = no Claude calls (default). anthropic = real Claude; put the key ONLY in the server's .env.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# Replies (main) and summaries/memory (fast)
LLM_MODEL_MAIN=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5
LLM_TIMEOUT_SECONDS=60
# Re-run a request declined by Anthropic's safety classifiers on a fallback model
LLM_REFUSAL_FALLBACK=true
LLM_EFFORT_REPLY=medium
LLM_EFFORT_FAST=low
LLM_REPLY_MAX_TOKENS=2048

# --- AI engine (Phase 3) ---
# false = no AI drafts/replies for any tenant (inbound messages are still stored)
AI_ENGINE_ENABLED=true
# Below this self-reported confidence an auto reply becomes a draft for approval
AI_MIN_AUTO_CONFIDENCE=0.7
AI_MAX_AUTO_REPLIES_PER_CHANNEL_HOUR=60
AI_MAX_AUTO_REPLIES_PER_CONVERSATION_10MIN=5
AI_MAX_REPLY_CHARS=1500
AI_SHORT_TERM_WINDOW=20
AI_SHORT_TERM_TTL_HOURS=24
AI_MEMORY_UPDATE_EVERY=6
AI_LONG_TERM_IN_PROMPT=10
# Staff replied by hand (app or Zalo): AI stays silent this many minutes (0 = off)
HUMAN_TAKEOVER_AUTO_MINUTES=30

# --- Zalo channels (Phase 2) ---
# mock = outbound messages stay in memory (no Zalo calls). real = official Zalo OA / Bot APIs.
ZALO_CHANNEL_BACKEND=mock
# Public HTTPS URL of this app; webhook and OAuth callback URLs are built from it.
PUBLIC_BASE_URL=
ZALO_HTTP_TIMEOUT_SECONDS=10
# Zalo OA app from developers.zalo.me (one app serves every tenant's OA)
ZALO_OA_APP_ID=
ZALO_OA_APP_SECRET=
# "OA Secret Key" on the app's Webhook page (used to check X-ZEvent-Signature)
ZALO_OA_WEBHOOK_SECRET=
# Must match the callback URL registered in the Zalo app: <PUBLIC_BASE_URL>/oauth/zalo-oa/callback/
ZALO_OA_OAUTH_REDIRECT_URI=
# Optional frontend page to land on after OAuth (?status=success|error&message=&channel_id=)
ZALO_OA_OAUTH_RESULT_URL=
ZALO_OA_OAUTH_URL=https://oauth.zaloapp.com/v4/oa
ZALO_OA_API_URL=https://openapi.zalo.me
ZALO_OA_TOKEN_REFRESH_MARGIN_SECONDS=3600
ZALO_OA_SYNC_PAGE_SIZE=50
ZALO_OA_SYNC_MAX_CONTACTS=5000
# Domain verification code from the Zalo developer console (served at /zalo_verifier<code>.html)
ZALO_SITE_VERIFICATION_CODE=
# Zalo Bot Platform (bot tokens are entered per channel in the app, stored encrypted)
ZALO_BOT_API_URL=https://bot-api.zaloplatforms.com
ZALO_BOT_POLL_TIMEOUT_SECONDS=10
ZALO_BOT_POLL_INTERVAL_SECONDS=15
# Personal Zalo (unofficial login, Phase 2b). Keep false unless the owner decided otherwise.
# See Kickoff section 3 and docs/PHASE2B_ZALO_PERSONAL.md.
ZALO_PERSONAL_UNOFFICIAL_ENABLED=false
# Kill switch for every tenant: true stops all personal-channel sends at once.
ZALO_PERSONAL_EMERGENCY_STOP=false
# Node sidecar (zca-js). Shared secret signs requests both ways; >= 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ZALO_PERSONAL_SIDECAR_URL=http://zalo-personal:3100
ZALO_PERSONAL_SIDECAR_SECRET=
ZALO_PERSONAL_SIGNATURE_TOLERANCE_SECONDS=300
# Where the sidecar posts events (the Django app, internal network)
ZALO_PERSONAL_DJANGO_URL=http://web:8000
# Send limits (a channel's config.limits may only make them stricter)
ZALO_PERSONAL_SEND_WINDOW=07:30-21:30
ZALO_PERSONAL_MAX_PER_MINUTE=4
ZALO_PERSONAL_MAX_PER_HOUR=40
ZALO_PERSONAL_MAX_PER_DAY=150
ZALO_PERSONAL_MAX_PER_CONTACT_PER_HOUR=10
ZALO_PERSONAL_MIN_GAP_SECONDS=8
ZALO_PERSONAL_MIN_REPLY_DELAY_SECONDS=5
ZALO_PERSONAL_MAX_REPLY_DELAY_SECONDS=45
ZALO_PERSONAL_TYPING_CHARS_PER_SECOND=6
# Only reply when the contact wrote within this many hours
ZALO_PERSONAL_REPLY_WINDOW_HOURS=24
# Auto-stop after this many failed sends in a row
ZALO_PERSONAL_MAX_CONSECUTIVE_FAILURES=3

# --- AIVA integration: off | sandbox | live (live needs owner approval) ---
# live also requires AIVA_LIVE_APPROVED=true (set only after the owner approves Phase 6)
AIVA_INTEGRATION_MODE=off
AIVA_LIVE_APPROVED=false
# Number/date of the director's written approval of live (Phase 6), e.g. "QD-06/2026 01/12/2026"
AIVA_LIVE_APPROVAL_REF=
# Outbound Zalo AI -> AIVA: http (signed webhooks to AIVA_BASE_URL) | mock (sandbox only)
AIVA_CLIENT=http
AIVA_BASE_URL=
AIVA_EVENTS_PATH=/api/integration/zalo-ai/v1/events
AIVA_HEALTH_PATH=/api/integration/zalo-ai/v1/health
# HMAC secret for webhooks we send to AIVA (X-Signature)
AIVA_WEBHOOK_SECRET=
# Optional bearer token AIVA issues to us for its webhook endpoint
AIVA_OUTBOUND_TOKEN=
AIVA_HTTP_TIMEOUT_SECONDS=10
# Inbound AIVA -> Zalo AI (/api/integration/v1/): bearer token + HMAC secret AIVA uses
AIVA_SERVICE_TOKEN=
AIVA_INBOUND_SECRET=
AIVA_SIGNATURE_TOLERANCE_SECONDS=300
# Outbox retry: base*2^(n-1) seconds, capped, then dead-letter after MAX_ATTEMPTS
AIVA_OUTBOX_MAX_ATTEMPTS=8
AIVA_OUTBOX_BACKOFF_BASE_SECONDS=30
AIVA_OUTBOX_BACKOFF_MAX_SECONDS=3600
AIVA_OUTBOX_BATCH_SIZE=50
AIVA_SUMMARY_MIN_INTERVAL_MINUTES=60
AIVA_PROFILE_SUGGESTION_MIN_IMPORTANCE=7

# --- App behaviour ---
DEFAULT_AI_RESPONSE_DELAY_SECONDS=3
APPROVAL_EXPIRY_HOURS=24
MAX_MEMORY_PER_CONTACT=100
CELERY_TASK_ALWAYS_EAGER=false

# --- Real-time notifications (Phase 4): redis (default, needed with several processes) | memory
CHANNEL_LAYER=redis

# --- Phase 5: operations -----------------------------------------------------------------
# Database connection pool per process (PostgreSQL only; DB_POOL=false -> CONN_MAX_AGE)
DB_POOL=true
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=10
# locmem (one process) | redis (needed for throttling with several processes; prod forces redis)
CACHE_BACKEND=locmem
# Login / signup / token refresh rate limits per client IP
THROTTLE_AUTH_LOGIN=10/min
THROTTLE_AUTH_REGISTER=5/hour
THROTTLE_AUTH_REFRESH=30/min
# Reverse proxies in front of the app that append X-Forwarded-For (0 = ignore the header)
TRUSTED_PROXY_COUNT=0
# text | json (one JSON object per log line)
LOG_FORMAT=text
# Bearer token for /metrics/ (Prometheus). Empty = endpoint disabled.
METRICS_TOKEN=
ADMIN_URL=admin/
# Mail unhandled errors (HTTP 500) to these addresses (comma separated) via SMTP
ERROR_EMAIL_TO=
SERVER_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Production only (gunicorn + uvicorn workers)
WEB_CONCURRENCY=3
# Used only when DB_POOL=false or the database is not PostgreSQL
DB_CONN_MAX_AGE=60
# Defaults to REDIS_URL
CACHE_REDIS_URL=
HTTPX_LOG_LEVEL=WARNING
# Production HTTPS (config/settings/production.py)
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false
# Zalo OA OAuth internals (rarely changed)
ZALO_OA_OAUTH_STATE_TTL_SECONDS=600
ZALO_OA_DEFAULT_TOKEN_TTL_SECONDS=90000
# Host names used by internal probes on the Docker network (production)
INTERNAL_HOSTS=web,127.0.0.1,localhost
